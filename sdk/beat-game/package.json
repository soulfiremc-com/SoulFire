{
  "name": "@soulfiremc/beat-game",
  "version": "2.10.4",
  "description": "Effect-first beat-the-game runner for the official SoulFire SDK.",
  "keywords": [
    "automation",
    "bot",
    "effect",
    "minecraft",
    "soulfire"
  ],
  "homepage": "https://soulfiremc.com/docs/sdk/automation",
  "bugs": {
    "url": "https://github.com/soulfiremc-com/SoulFire/issues"
  },
  "license": "AGPL-3.0-only",
  "author": "SoulFire",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soulfiremc-com/SoulFire.git",
    "directory": "sdk/beat-game"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run clean && tsc -p tsconfig.build.json",
    "check": "bun run typecheck && bun run test && bun run build && bun run typecheck:smoke && bun run check:boundary && bun run check:browser",
    "check:boundary": "node scripts/check-public-sdk-boundary.mjs",
    "check:browser": "node scripts/check-browser-bundle.mjs",
    "clean": "node scripts/clean-dist.mjs",
    "prepack": "bun run build",
    "smoke:e2e": "bun run --filter @soulfiremc/sdk build && bun run build && bun run typecheck:smoke && ../../gradlew -p ../.. :dedicated-launcher:uberJar && node --experimental-strip-types smoke/e2e.ts",
    "smoke:controlled": "SOULFIRE_E2E_CONTROLLED=true bun run smoke:e2e",
    "smoke:qualify": "node --experimental-strip-types smoke/qualify.ts",
    "smoke:qualify:controlled": "SOULFIRE_QUALIFICATION_CONTROLLED=true node --experimental-strip-types smoke/qualify.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:smoke": "tsc -p tsconfig.smoke.json --noEmit"
  },
  "dependencies": {
    "@soulfiremc/sdk": "workspace:*"
  },
  "devDependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@effect/platform-node": "4.0.5",
    "@types/node": "26.6.5",
    "effect": "4.0.5",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "effect": "^4.0.0"
  }
}
