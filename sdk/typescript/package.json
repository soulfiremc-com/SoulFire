{
  "name": "@soulfiremc/sdk",
  "version": "2.10.4",
  "description": "TypeScript SDK for automating SoulFire bots over gRPC-Web.",
  "keywords": [
    "automation",
    "bot",
    "grpc-web",
    "minecraft",
    "soulfire"
  ],
  "homepage": "https://soulfiremc.com/docs/sdk/typescript",
  "bugs": {
    "url": "https://github.com/soulfiremc-com/SoulFire/issues"
  },
  "license": "AGPL-3.0-only",
  "author": "SoulFire",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soulfiremc-com/SoulFire.git",
    "directory": "sdk/typescript"
  },
  "bin": {
    "soulfire-sdk": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./platform": {
      "types": "./dist/platform.d.ts",
      "import": "./dist/platform.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./bun": {
      "types": "./dist/bun.d.ts",
      "import": "./dist/bun.js"
    },
    "./plugin-generator": {
      "types": "./dist/plugin-generator.d.ts",
      "import": "./dist/plugin-generator.js"
    },
    "./generated/*": {
      "types": "./dist/generated/*.d.ts",
      "import": "./dist/generated/*.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run clean && tsc -p tsconfig.build.json",
    "check": "bun run typecheck && bun run test && bun run build && bun run check:browser",
    "check:browser": "node scripts/check-browser-bundle.mjs",
    "clean": "node scripts/clean-dist.mjs",
    "prepack": "bun run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-web": "2.2.0",
    "@effect/platform-node": "4.0.5",
    "adm-zip": "0.6.1",
    "tar": "7.5.22"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "effect": "4.0.5",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "effect": "^4.0.0"
  },
  "optionalDependencies": {
    "@bufbuild/buf-darwin-arm64": "1.74.0",
    "@bufbuild/buf-darwin-x64": "1.74.0",
    "@bufbuild/buf-linux-aarch64": "1.74.0",
    "@bufbuild/buf-linux-armv7": "1.74.0",
    "@bufbuild/buf-linux-x64": "1.74.0",
    "@bufbuild/buf-win32-arm64": "1.74.0",
    "@bufbuild/buf-win32-x64": "1.74.0"
  }
}
