{
  "name": "soulfire-monorepo",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "e2e",
    "sdk/beat-game",
    "sdk/typescript"
  ],
  "trustedDependencies": [
    "@bufbuild/buf",
    "esbuild"
  ],
  "scripts": {
    "prepare": "./scripts/prepare-effect.sh",
    "sdk:generate": "buf generate && node scripts/format-generated-sdks.mjs",
    "sdk:lint-proto": "buf lint",
    "sdk:check": "bun run sdk:generate && bun run sdk:lint-proto && bun run --filter @soulfiremc/sdk check"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.73.0",
    "@bufbuild/protoc-gen-es": "2.16.0"
  }
}
